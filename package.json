{
  "name": "pactora-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "config:check": "node packages/config/bin/check.mjs",
    "db:migrate": "pnpm --filter @pactora/db migrate",
    "dev": "pnpm -r --parallel dev",
    "demo": "node scripts/demo.mjs",
    "demo:local": "node scripts/local-up.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@noble/curves": "1.9.1",
    "@pactora/agent-core": "workspace:*",
    "@pactora/config": "workspace:*",
    "@pactora/db": "workspace:*",
    "@pactora/near": "workspace:*",
    "@pactora/sdk": "workspace:*",
    "@pactora/shared": "workspace:*",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "globals": "^15",
    "near-api-js": "7.4.0",
    "postgres": "^3.4.5",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8",
    "vitest": "^3.2.7",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "vitest>tinypool": "^2.1.2",
      "vitest>vite": "^6.4.4",
      "@vitest/mocker>vite": "^6.4.4",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
