# ─────────────────────────────────────────────────────────────────────────
# Pactora backend — copy to `.env` and fill in.
#
# Secrets and wiring ONLY. Chain facts, protocol parameters and contract
# addresses all come from the contracts checkout — see docs/08.
# `.env` is gitignored (verified); `.env.example` ships empty.
# ─────────────────────────────────────────────────────────────────────────

# ── which networks this process serves ───────────────────────────────────
# CAIP-2 ids. A list, not a switch: "near:testnet,near:sandbox" serves both.
# `pnpm demo:local` needs none of this file: it runs on near:sandbox.
ENABLED_CHAINS=near:testnet
DEFAULT_CHAIN=near:testnet
PACTORA_CONTRACTS_ROOT=../pactora-contracts-near

# Optional per-network RPC override, named by the network's slug. Absent,
# the contracts repo's config/networks.json default is used. The network is
# in the NAME so a mainnet client cannot be pointed at a testnet RPC by
# editing the wrong line.
RPC_URL_TESTNET=

# ── datastores ───────────────────────────────────────────────────────────
# 127.0.0.1, never "localhost": Node 24 resolves localhost to IPv6 ::1 while
# Docker publishes on IPv4, so "localhost" fails with ECONNREFUSED ::1.
# 5443: 5432 is another local Postgres and 5442 is the Monad build's, on
# this machine, and connecting to the wrong database is worse than failing.
DATABASE_URL=postgres://pactora:pactora@127.0.0.1:5443/pactora_near

# ── services ─────────────────────────────────────────────────────────────
PORT=8080
SIGNER_PORT=7070
# On Railway this is the signer's PRIVATE hostname. Never expose it publicly:
# an unauthenticated signing endpoint on the internet is not recoverable.
SIGNER_URL=http://127.0.0.1:7070
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────
# SIGNER KEYS — the agent wallets' function-call keys
#
# Imported keys, one source at most (which one signs must never be a guess):
#   SIGNER_DEV_CREDENTIALS  a near-cli credential object, or an array of them:
#                           {"account_id":"bot.<you>.testnet","private_key":"ed25519:..."}
#                           Testnet only — the signer refuses it anywhere else.
#   SIGNER_KMS_KEYS         AWS KMS ed25519 keys (below).
# Generated keys (POST /keys) are kept encrypted in the database when
# SIGNER_KEY_PASSPHRASE is set.
# ─────────────────────────────────────────────────────────────────────────
SIGNER_DEV_CREDENTIALS=
SIGNER_KEY_PASSPHRASE=

# Shared secret between the API and the signer. Set it in BOTH services. With
# it, the signer listens on every interface (Railway private networking) and
# refuses any request that does not present it. Without it, the signer binds
# to 127.0.0.1 only and refuses a non-loopback SIGNER_HOST.
SIGNER_TOKEN=

# Browser origins allowed to call the API, comma-separated — e.g. the Vercel
# URL of pactora-interface-near. Empty allows any origin, which is safe because the
# API authenticates by bearer key, never by cookie.
CORS_ORIGINS=
# Interface to bind. Defaults to 0.0.0.0 with a token, 127.0.0.1 without.
SIGNER_HOST=

# The keeper, inside the signer process: calls the contract's permissionless
# exits (refund an unaccepted or undelivered job, pay an unreviewed result)
# once their deadlines pass. A NEAR account of its own with its own key,
# holding only gas — never a wallet the signer signs for, or the two race for
# nonces. KEEPER_SECRET_KEY (ed25519:...) is testnet only; elsewhere use
# KEEPER_KMS_KEY_ID. No KEEPER_ACCOUNT_ID means no keeper runs, and expired
# jobs wait for someone else to call the exit.
KEEPER_ACCOUNT_ID=
KEEPER_SECRET_KEY=
KEEPER_INTERVAL_MS=15000

# ─────────────────────────────────────────────────────────────────────────
# AWS KMS — how the signer signs off testnet, where every raw key above is
# refused. Keys are ed25519 and never leave KMS; the signer asks it to sign
# each transaction. One imported source at a time: KMS or dev credentials.
# Credentials come from the AWS SDK's default chain (an instance role, or the
# two AWS_* variables).
# ─────────────────────────────────────────────────────────────────────────
SIGNER_KMS_KEYS=                   # {"<wallet account>": "<KMS key id>"}
KEEPER_KMS_KEY_ID=                 # the keeper's key, instead of KEEPER_SECRET_KEY
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── agents: mode and provider chain ──────────────────────────────────────
# Two independent axes, deliberately separate.
#
# AGENT_MODE decides whether tokens are spent at all:
#   cached  replay a recording. FREE. The development default.
#   live    call providers.
#   record  call providers AND save, so later runs can be free.
AGENT_MODE=cached
AGENT_CACHE_DIR=.agent-cache
# A replay re-enacts each call's recorded latency, up to this many ms, so a
# cached run has the rhythm of a live one. Unset = 8000; 0 = instant.
# AGENT_REPLAY_MAX_MS=8000
#
# BRAIN_CHAIN decides the provider ORDER — a deliberate cost/quality choice.
# Moving ALONG the chain on a rate limit or outage is automatic, because a
# failure at 11pm on submission day has nobody around to flip a flag.
# `cached` is always appended as the final backstop.
BRAIN_CHAIN=gemini,groq,ollama,claude
BRAIN_CHAIN_ORCHESTRATOR=claude,gemini,groq,ollama
# An entry may name a Gemini model — gemini:gemini-3.6-flash — to fall back across models.

# ── provider keys — every one of these has a FREE tier ───────────────────
# Gemini    ~1,500 req/day   aistudio.google.com     (no card)
GEMINI_API_KEY=
# Groq      1,000 req/day, 200K tokens/day, fastest  console.groq.com  (no card)
GROQ_API_KEY=
# Ollama    unlimited, local, works offline: `ollama pull qwen2.5:7b`
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Claude — paid. Used for the ORCHESTRATOR, where planning and judgement are
# visible and a weaker model shows. Set a SPEND CAP on this key: the agents
# are autonomous, so the cap should be real rather than notional.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_WORKER_MODEL=claude-haiku-4-5

# NEAR AI Cloud as the JUDGE (docs.near.ai/cloud, OpenAI-compatible). Off by
# default: `chain` (or unset) lets the orchestrator's own brain judge.
# JUDGE_PROVIDER=near-ai needs NEAR_AI_API_KEY, or the api refuses to start.
# AGENT_MODE=cached still replays and never calls it. Empty model/base URL
# use zai-org/GLM-5.1-FP8 and https://cloud-api.near.ai/v1.
JUDGE_PROVIDER=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=

# ── agent identity ───────────────────────────────────────────────────────
# What a worker bot or the orchestrator needs to act AS an agent. Without
# these nothing in apps/agents/ can start, which .env.example previously did
# not mention at all.
PACTORA_API_URL=http://127.0.0.1:8080
PACTORA_API_KEY=                    # the ax_... key returned by POST /v1/agents
PACTORA_CHAIN_ID=near:testnet

# The API's own address, used when it starts an orchestrator run against
# itself. Defaults to http://127.0.0.1:$PORT.
PACTORA_SELF_URL=

# ── model overrides ──────────────────────────────────────────────────────
# Defaults are set in code; these only override them.
GEMINI_MODEL=
GROQ_MODEL=

# ── indexer tuning ───────────────────────────────────────────────────────
INDEXER_POLL_MS=2000               # normal cadence
INDEXER_MAX_BACKOFF_MS=60000       # ceiling when the RPC is failing
INDEXER_HEALTH_PORT=               # serve /health /ready /metrics; unset → none
INDEXER_START_AT_HEAD=0            # 1: a FIRST start begins at the head, not the deployment block

# ── evidence photos (docs/26 F6, branch human-work) ──────────────────────
# A private S3-compatible bucket with server-side encryption. Locally:
# `docker compose up -d` starts MinIO on 127.0.0.1:9110 (dev credentials in
# docker-compose.yml). In production the API refuses to start with uploads
# on and no bucket. Unset outside production: uploads answer 503.
EVIDENCE_UPLOADS=on                # on | off
OBJECT_STORE_BUCKET=
OBJECT_STORE_ENDPOINT=             # unset → AWS S3; MinIO: http://127.0.0.1:9110
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=        # both or neither; neither → the AWS default chain
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_FORCE_PATH_STYLE=0    # 1 for MinIO
OBJECT_STORE_SSE=AES256            # AES256 | aws:kms | none

# ── events, webhooks and the test faucet (docs/26 F9, F23, branch human-work) ──
# WEBHOOK_SECRET_KEY: 32 random bytes (64 hex), shared by the api and the
# notifier; it seals each webhook's signing secret. `openssl rand -hex 32`.
# Unset: the api refuses to create webhooks and the notifier does not start.
WEBHOOK_SECRET_KEY=
WEBHOOK_ALLOW_PRIVATE=             # 1 = deliver to http/private addresses; local development only
NOTIFIER_CONCURRENCY=8             # webhooks sent to at once
NOTIFIER_TIMEOUT_MS=10000
NOTIFIER_IDLE_MS=1000
NOTIFIER_HEALTH_PORT=              # serve /health /ready /metrics; unset → none
# The faucet (testnet and sandbox only): a SEPARATE account with a limited
# float of the payment token, never the token's owner. Its key is in the
# signer only. No FAUCET_ACCOUNT_ID → no faucet.
FAUCET_ACCOUNT_ID=
FAUCET_SECRET_KEY=
FAUCET_MAX_PER_SEND=10000000       # signer: the most one send may carry (base units)
FAUCET_AMOUNT=5000000              # api: per claim (base units; 5 mUSDC)
FAUCET_PER_IP_PER_DAY=5
FAUCET_DAILY_CAP=500000000         # api: for everyone together, per UTC day

# ── identity checks and sanctions screening (docs/26 F13, F14, branch human-work) ──
# Screening is refused off in production. Lists: `pnpm sanctions:refresh`, daily.
SANCTIONS_SCREENING=on             # on | off (development only)
IDENTITY_PROVIDER=none             # none | simulated (test chains only; no document is checked)
KYC_WEBHOOK_SECRET=                # 32+ characters; verifies the provider's webhooks
KYC_PAGE_BASE=http://localhost:3000   # where the simulated provider's page lives
COMPLIANCE_REVIEWERS=              # NEAR accounts, comma-separated; production needs two
OFAC_SDN_URL=                      # refresh script overrides; unset → the publishers' URLs
OFAC_ALT_URL=
UN_LIST_URL=
UK_LIST_URL=

# ── channels: Telegram and email (docs/26 F11, F12, branch human-work) ──
TELEGRAM_BOT_TOKEN=                # apps/channels: from @BotFather; unset → no Telegram
TELEGRAM_BOT_USERNAME=             # api: the bot's @username, shown when linking
EMAIL_PROVIDER=none                # apps/channels: none | fake (development only)
EMAIL_CHANNEL=0                    # api: 1 when apps/channels can send email
CHANNELS_SITE_URL=http://localhost:3000   # where links in messages point
CHANNELS_HEALTH_PORT=
CHANNELS_INTERVAL_MS=2000

# ── operations (docs/14) ─────────────────────────────────────────────────
# Names only. The full list, with every default, is docs/08 §5.
NODE_ENV=development               # production → CORS_ORIGINS required, /metrics needs a token
METRICS_TOKEN=                     # bearer for /metrics
TRUST_PROXY=0                      # proxy hops in front: 1 behind Railway; true trusts all (avoid)
RATE_LIMIT_PER_MINUTE=600          # per client IP, per api process
SSE_MAX_STREAMS=1000               # open live streams per kind, per api process; then 503
SSE_MAX_STREAMS_PER_CLIENT=20      # of those, per client address (set TRUST_PROXY behind a proxy)
RUNS_PER_DAY=0                     # runs one orchestrator may start per rolling 24 h; 0 = no cap (hosted: 10)
STATUS_MAX_INDEXER_LAG_BLOCKS=150  # /v1/status calls the indexer degraded beyond this
GIT_SHA=                           # build commit; images bake it in (Dockerfile)

# ── less often needed (docs/08 §5 has every name the services read) ────────
HOST=0.0.0.0                       # bind address (Railway: ::)
SIGNER_TIMEOUT_MS=30000            # how long the api waits for the signer
DB_POOL_MAX=                       # connection pool size (defaults: api 5, signer 5, indexer 3)
LOCK_POOL_MAX=10                   # signer: pool for per-agent nonce advisory locks
BUILD_TIME=                        # ISO-8601; images record their own
WORKER_POLL_MS=1000                # how often a worker polls for jobs
PACTORA_AGENT_ID=                   # the worker's own id; required with X402_PORT
X402_PORT=                         # serve an x402 pay-per-request endpoint on this port
X402_HOST=127.0.0.1
X402_PUBLIC_URL=                   # the URL clients are quoted; default http://127.0.0.1:<X402_PORT>
X402_SCHEMES=pactora-directpay     # comma list; add pactora-escrow for the refundable scheme
